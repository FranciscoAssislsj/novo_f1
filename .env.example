# URL base da OpenF1 API
OPENF1_BASE_URL=https://api.openf1.org/v1
# Token opcional (só para dados ao vivo; o histórico não exige autenticação)
OPENF1_API_TOKEN=
# Diretório do cache local em Parquet
DATA_DIR=data
# Timeout de cada requisição HTTP (segundos)
REQUEST_TIMEOUT=30
# Número máximo de novas tentativas em 429/5xx/erros de rede
MAX_RETRIES=3
# Intervalo mínimo entre requisições (segundos)
MIN_REQUEST_INTERVAL=0.35
# Fator base do backoff exponencial (segundos)
BACKOFF_FACTOR=1.0
# Validade do cache de meetings/sessions do ano corrente (horas)
CALENDAR_TTL_HOURS=24
